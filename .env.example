# 复制为 .env 后填写：cp .env.example .env

# ---- 模型（格式 "供应商:模型名"）----
# 填 fake 则使用离线假模型：不花钱、不联网，用来检查代码能不能跑通
LC_MODEL=openai:gpt-5.5
LC_SMALL_MODEL=openai:gpt-5.4-mini
# 其他例子：
# LC_MODEL=anthropic:claude-sonnet-4-6
# LC_MODEL=google_genai:gemini-3.6-flash
# LC_MODEL=ollama:qwen3            （本地 Ollama，需 pip install langchain-ollama）
# LC_MODEL=deepseek:deepseek-chat  （需 pip install langchain-deepseek）

# 第 17 章与综合项目的向量模型
LC_EMBEDDINGS=openai:text-embedding-3-small

# ---- API key：只填你用到的 ----
OPENAI_API_KEY=
# OPENAI_BASE_URL=               # OpenAI 兼容的代理 / 中转地址
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=

# ---- LangSmith 追踪（第 19 章，可选）----
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=langchain-learning
